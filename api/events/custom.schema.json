{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mass.local/schemas/custom-v1",
  "type": "object",
  "required": ["type", "name", "value"],
  "properties": {
    "type": {"const": "CUSTOM"},
    "name": {"type": "string", "pattern": "^mass\\.[a-z.]+\\.v1$"},
    "value": {
      "type": "object",
      "required": ["schemaVersion", "threadId", "runId", "sourceEventIds"],
      "properties": {
        "schemaVersion": {"const": 1},
        "threadId": {"type": "string", "minLength": 1},
        "runId": {"type": "string", "minLength": 1},
        "sourceEventIds": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    }
  }
}
